                    }
                }
            },
            "LibraryPath": "@OVS_USD_RESOLVER_LIBRARY_PATH@",
            "Name": "ovstorage USD Resolver",
            "ResourcePath": "@OVS_USD_RESOLVER_RESOURCE_PATH@",
            "Root": "@OVS_USD_RESOLVER_PLUGIN_ROOT@",
            "Type": "library"
        }
    ]
}
