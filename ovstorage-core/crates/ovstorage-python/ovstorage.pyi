class Library:
    def __init__(self) -> None: ...
    @staticmethod
    def open(
        interactive_auth_capability: int | None = None,
        credential_cache_durability: int | None = None,
        credential_callback: Callable[[str, str], Awaitable[Mapping[str, Any]] | Mapping[str, Any]] | None = None,
        credential_callback_name: str | None = None,
        allow_test_plugins: bool = False,
    ) -> Library: ...
    async def load_plugin(self, path: str) -> None: ...
    async def load_plugins_from_dir(self, dir: str | None = None) -> None: ...
    async def load_config(self, path: str | None = None) -> list[Connection]: ...
    async def set_credential(
        self,
        backend_id: str,
        principal_id: str,
        credential: Mapping[str, Any],
    ) -> None: ...
    async def stat(self, address: str, full_metadata: bool = False) -> Info: ...
    async def read_bytes(
        self, address: str, max_bytes: int | None = None
    ) -> tuple[bytes, Info]: ...
    async def read_stream(
        self, address: str, max_bytes: int | None = None
    ) -> tuple[AsyncReadStream, Info]: ...
    async def materialize(self, address: str) -> LocalDelegate: ...
    async def write(
        self, address: str, data: bytes | bytearray | memoryview
    ) -> Info: ...
    async def delete(self, address: str) -> None: ...
    async def list(
        self,
        prefix: str,
        recursive: bool = False,
        max_results: int | None = None,
        page_token: str | None = None,
        full_metadata: bool = False,
    ) -> ListPage: ...
    async def list_versions(
        self,
        address: str,
        max_results: int | None = None,
        page_token: str | None = None,
    ) -> VersionPage: ...
    async def get_latest_version(self, address: str) -> Info: ...
    async def copy(self, src: str, dest: str) -> Info: ...
    async def rename(self, src: str, dest: str) -> None: ...
    async def create_directory(self, address: str) -> Info: ...
    async def delete_directory(self, address: str) -> None: ...
    async def update_metadata(
        self,
        address: str,
        set: Mapping[str, str] | None = None,
        remove: Sequence[str] | None = None,
        message: str | None = None,
    ) -> Info: ...
    async def check_access(
        self,
        address: str,
        read: bool = False,
        write: bool = False,
        delete: bool = False,
        update_metadata: bool = False,
    ) -> AccessDecision: ...
    # Connection / auth / aliases / discovery
    async def add_connection(self, request: ConnectionRequest) -> Connection: ...
    async def remove_connection(self, connection_id: str) -> None: ...
    async def list_connections(self) -> builtins.list[Connection]: ...
    async def update_connection_credentials(
        self, connection_id: str, credentials: SecretBundle
    ) -> Connection: ...
    async def authenticate_connection(
        self, connection_id: str
    ) -> AsyncAuthEventStream: ...
    async def add_alias(self, request: AliasRequest) -> Alias: ...
    async def remove_alias(self, alias_id: str) -> None: ...
    async def list_aliases(self) -> builtins.list[Alias]: ...
    async def watch_address_roots(self) -> AsyncAddressRootSnapshotStream: ...
    async def set_address_visibility(
        self, address: str, visibility: str, persist: bool
    ) -> AddressVisibilityOverride: ...
    async def list_address_visibility_overrides(
        self,
    ) -> builtins.list[AddressVisibilityOverride]: ...
    async def list_address_roots(self) -> builtins.list[AddressRoot]: ...
    async def list_backend_kinds(self) -> builtins.list[BackendKindDescriptor]: ...
    async def capabilities_for(self, prefix: str) -> Capabilities: ...
