    @property
    def supports_access_check(self) -> bool: ...
    @property
    def supports_watch_directory(self) -> bool: ...
    @property
    def supports_version_listing(self) -> bool: ...
    @property
    def redirect_size_threshold(self) -> int | None: ...


class Connection:
