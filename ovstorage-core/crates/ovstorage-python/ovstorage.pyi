class CredentialCacheDurability:
    """Mirror of the Rust `CredentialCacheDurability` enum (ticket #64).

    Pass the integer value to `Library.open(credential_cache_durability=...)`.
    """

    PERSISTENT: int
    IN_MEMORY_ONLY: int


class InteractiveAuthCapability:
    """Mirror of the Rust `InteractiveAuthCapability` enum (tickets #62 / #64).

    Pass the integer value to `Library.open(interactive_auth_capability=...)`.
    """

    BROWSER: int
    HEADLESS: int
    NONE: int


