@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(NOT OVS_USD_SDK_ROOT OR NOT EXISTS "${OVS_USD_SDK_ROOT}/lib/@_ovs_usd_monolithic@")
    set(OvStorageUsdResolver_FOUND FALSE)
    set(OvStorageUsdResolver_NOT_FOUND_MESSAGE "Set OVS_USD_SDK_ROOT to this native package's exact Kit USD SDK")
    return()
endif()
file(SHA256 "${OVS_USD_SDK_ROOT}/lib/@_ovs_usd_monolithic@" _ovs_consumer_usd_hash)
if(NOT _ovs_consumer_usd_hash STREQUAL "@OVS_NATIVE_USD_SHA256@")
    set(OvStorageUsdResolver_FOUND FALSE)
    set(OvStorageUsdResolver_NOT_FOUND_MESSAGE "Host USD library does not match this native package's exact SDK")
    return()
endif()
# An embedding host may already have selected USD. Never silently use a
# different existing target just because the separately supplied SDK matches.
if(TARGET usd_m)
    get_target_property(_ovs_host_usd usd_m IMPORTED_LOCATION_RELEASE)
    if(NOT _ovs_host_usd)
        get_target_property(_ovs_host_usd usd_m IMPORTED_LOCATION)
    endif()
    if(NOT _ovs_host_usd OR NOT EXISTS "${_ovs_host_usd}")
        set(OvStorageUsdResolver_FOUND FALSE)
        set(OvStorageUsdResolver_NOT_FOUND_MESSAGE "Existing usd_m target has no verifiable Release library")
        return()
    endif()
    file(SHA256 "${_ovs_host_usd}" _ovs_host_usd_hash)
    if(NOT _ovs_host_usd_hash STREQUAL "@OVS_NATIVE_USD_SHA256@")
        set(OvStorageUsdResolver_FOUND FALSE)
        set(OvStorageUsdResolver_NOT_FOUND_MESSAGE "Existing usd_m target belongs to a different host USD build")
        return()
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NvidiaKitUsd.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/OvStorageUsdResolverTargets.cmake")
get_filename_component(_ovs_native_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set_and_check(OvStorageUsdResolver_PLUGIN_DIR "${_ovs_native_prefix}/plugin")
check_required_components(OvStorageUsdResolver)
